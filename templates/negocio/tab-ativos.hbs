<div class="tab ativos flexcol {{#if ativa}}active{{/if}}" data-group="primary" data-tab="ativos">

	<ul class="item-list t20neg-bloco">
		<li class="item flexrow item-header">
			<div class="item-name flex2">{{localize "T20NEG.SecaoAtivos"}}</div>
			<div class="item-detail">{{usados}}/{{slots}}</div>
			<div class="item-controls flexrow">
				<a class="item-control" data-action="alternarTodos"
				   data-tooltip="{{#if algumAberto}}{{localize "T20NEG.RecolherTodos"}}{{else}}{{localize "T20NEG.ExpandirTodos"}}{{/if}}">
					<i class="fas {{#if algumAberto}}fa-compress-alt{{else}}fa-expand-alt{{/if}}"></i>
				</a>
				{{#if editavel}}
					<a class="item-control" data-action="renovarAventura"
					   data-tooltip="{{localize "T20NEG.BotaoRenovarAventura"}}"><i class="fas fa-rotate-right"></i></a>
				{{/if}}
			</div>
		</li>

		{{#if excedentes}}
			<li class="item flexrow t20neg-aviso-linha t20neg-alerta-linha">
				<i class="fas fa-triangle-exclamation noflex"></i>
				<span>{{localize "T20NEG.AvisoExcedentes" quantos=excedentes}}</span>
			</li>
		{{/if}}

		{{#each contratados}}
			<li class="item flexrow t20neg-acordeon {{#if this.aberto}}aberto{{/if}}"
			    data-ativo-id="{{this.id}}">

				{{!-- O cabeçalho inteiro abre e fecha; os detalhes ficam
				      guardados até alguém querer lê-los. --}}
				<div class="item-name flexrow flex2 t20neg-cabeca" data-action="alternarAtivo"
				     data-ativo-id="{{this.id}}">
					<i class="fas fa-chevron-right t20neg-seta noflex"></i>
					<span class="t20neg-vaga-nivel noflex">{{localize "T20NEG.NivelAbrev"}} {{this.vaga}}</span>
					<div class="item-image noflex" style="background-image: url('{{this.icone}}')"></div>
					<label>{{this.nome}}</label>
					{{#if this.copiado}}
						<span class="tag noflex">{{localize "T20NEG.ViaEspionagem"}}</span>
					{{/if}}
				</div>

				{{#if this.usos}}
					<div class="item-detail item-uses t20neg-usos-col"
					     data-tooltip="{{localize "T20NEG.UsosRestantesDica"}}">
						{{this.usos.restantes}}/{{this.usos.max}}
					</div>
				{{/if}}

				<div class="item-controls flexrow">
					{{#if ../editavel}}
					{{#if this.usos}}
						<a class="item-control {{#unless this.usos.restantes}}inativo{{/unless}}"
						   data-action="usarAtivo" data-ativo-id="{{this.id}}"
						   data-tooltip="{{localize "T20NEG.BotaoUsar"}}"><i class="fas fa-play"></i></a>
						<a class="item-control {{#unless this.usos.gastos}}inativo{{/unless}}"
						   data-action="devolverUso" data-ativo-id="{{this.id}}"
						   data-tooltip="{{localize "T20NEG.BotaoDevolverUso"}}"><i class="fas fa-rotate-left"></i></a>
					{{/if}}
					{{#if this.ehEspionagem}}
						<a class="item-control" data-action="escolherEspionagem"
						   data-tooltip="{{localize "T20NEG.BotaoTrocarCopia"}}"><i class="fas fa-arrows-rotate"></i></a>
					{{else if this.temEscolha}}
						<a class="item-control" data-action="editarEscolha" data-ativo-id="{{this.id}}"
						   data-tooltip="{{localize "T20NEG.BotaoEditarEscolha"}}"><i class="fas fa-pen"></i></a>
					{{/if}}
					{{#unless this.copiado}}
						<a class="item-control" data-action="removerAtivo" data-ativo-id="{{this.id}}"
						   data-tooltip="{{localize "T20NEG.BotaoRemoverAtivo"}}"><i class="fas fa-trash"></i></a>
					{{/unless}}
					{{/if}}
				</div>

				<div class="item-summary">
					<p class="t20neg-resumo">{{this.resumo}}</p>
					<p><label>{{localize "T20NEG.Efeito"}}</label> {{this.efeito}}</p>

					{{#if this.ehEspionagem}}
						<p class="t20neg-escolha-linha">
							<label>{{localize "T20NEG.AtivoCopiado"}}:</label>
							{{#if this.nomeCopiado}}{{this.nomeCopiado}}{{else}}{{localize "T20NEG.NenhumAtivoCopiado"}}{{/if}}
						</p>
					{{else if this.temEscolha}}
						<p class="t20neg-escolha-linha">
							<label>{{this.rotuloEscolha}}:</label>
							{{#if this.escolha}}{{this.escolha}}{{else}}{{localize "T20NEG.NaoDefinido"}}{{/if}}
						</p>
					{{/if}}

					<div class="t20neg-marcas">
						{{#if this.automatico}}
							<span class="tag ativo" data-tooltip="{{localize "T20NEG.MarcaAutoDica"}}"><i class="fas fa-wand-magic-sparkles"></i>{{localize "T20NEG.MarcaAuto"}}</span>
						{{/if}}
						{{#if this.condicao}}<span class="tag">{{this.condicao}}</span>{{/if}}
						{{#if this.travadoPor}}
							<span class="tag alerta" data-tooltip="{{localize "T20NEG.ExigidoPor" ativos=this.travadoPor}}"><i class="fas fa-link"></i>{{this.travadoPor}}</span>
						{{/if}}
					</div>
				</div>
			</li>
		{{/each}}

		{{#each vazios}}
			<li class="item flexrow t20neg-vaga" {{#if ../podeContratar}}data-action="adicionarAtivo"{{/if}}>
				<div class="item-name flexrow flex2">
					<i class="fas fa-circle-plus t20neg-seta noflex"></i>
					<span class="t20neg-vaga-nivel noflex">{{localize "T20NEG.NivelAbrev"}} {{this}}</span>
					<label>{{localize "T20NEG.SlotLivre"}}</label>
				</div>
			</li>
		{{/each}}
	</ul>

	{{#if editavel}}
		<footer class="t20neg-rodape">
			<button type="button" class="t20neg-acao t20neg-principal" data-action="adicionarAtivo"
			        {{#if semSlots}}disabled{{/if}}>
				<i class="fas fa-plus"></i>
				{{#if semSlots}}{{localize "T20NEG.SemSlotsLivres"}}{{else}}{{localize "T20NEG.BotaoAdicionarAtivo"}}{{/if}}
			</button>
		</footer>
	{{/if}}

	<p class="t20neg-fonte">{{fonte}}</p>
</div>
